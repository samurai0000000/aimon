#include <winver.h>
#include "Version.hxx"

LANGUAGE 9, 1

1 24 "aimon.manifest"
1 ICON "aimon.ico"

1 VERSIONINFO
 FILEVERSION AIMON_VERSION_MAJOR, AIMON_VERSION_MINOR, AIMON_VERSION_PATCH, 0
 PRODUCTVERSION AIMON_VERSION_MAJOR, AIMON_VERSION_MINOR, AIMON_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Charles Chiou"
      VALUE "FileDescription", "aimon AI Quota Monitor & EDA/CAD Bridge"
      VALUE "FileVersion", AIMON_VERSION_STRING ".0"
      VALUE "InternalName", "aimon"
      VALUE "LegalCopyright", "Copyright (C) 2026, Charles Chiou"
      VALUE "OriginalFilename", "aimon.exe"
      VALUE "ProductName", "aimon"
      VALUE "ProductVersion", AIMON_VERSION_STRING ".0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
